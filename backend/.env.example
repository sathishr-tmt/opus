# ============================================================
# OPUS backend environment — EXAMPLE FILE
# Copy to backend/.env and fill in real values.
# NEVER put real passwords, API keys, or secrets in this file.
# backend/.env is gitignored; this example file is committed.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Comma-separated list of allowed CORS origins (defaults to FRONTEND_URL)
# CORS_ORIGINS=https://your-frontend.example

# Authentication security — generate unique random values, 32+ characters each.
# Example command:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_RANDOM_VALUE_AT_LEAST_32_CHARS
APPROVAL_TOKEN_SECRET=CHANGE_ME_DIFFERENT_RANDOM_VALUE_32_CHARS

# Cookies
# Local HTTP development: COOKIE_SECURE=false, COOKIE_SAME_SITE=lax
# Production HTTPS same-site: COOKIE_SECURE=true, COOKIE_SAME_SITE=lax
# Production cross-site frontend/API: COOKIE_SECURE=true, COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# MongoDB connection
# Local development uses MongoDB Community Server.
# For production, replace this with your MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/opus

# Super Admin seed account (used only by: npm run seed:super-admin)
PRIMARY_ADMIN_NAME=CHANGE_ME_FULL_NAME
PRIMARY_ADMIN_EMAIL=CHANGE_ME@example.com
PRIMARY_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Email that receives new-account approval notifications
ADMIN_NOTIFICATION_EMAIL=CHANGE_ME@example.com

# SMTP settings for outgoing email (verification, approval, reset).
# For Gmail: enable 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=CHANGE_ME@example.com
SMTP_PASS=CHANGE_ME_APP_PASSWORD

# Name and address shown in outgoing emails
EMAIL_FROM_NAME="OPUS"
EMAIL_FROM_ADDRESS=CHANGE_ME@example.com

# Google OAuth for the optional Gmail response-tracking integration
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/callback

# Job source configuration
WORKDAY_SOURCES=[{"name":"Workday Careers","url":"https://workday.wd5.myworkdayjobs.com/Workday"}]
GREENHOUSE_COMPANIES=airbnb,databricks
LEVER_COMPANIES=netlify,postman
# Optional: USAJOBS_API_KEY and USAJOBS_USER_AGENT for the USAJOBS source
